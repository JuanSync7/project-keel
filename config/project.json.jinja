{
  "_comment": "Authoritative project facts: hand-edited, enforced by scripts/check_structure.py (check_H, CONVENTIONS section 15). Choose one frontend stack; list shipped stacks/transports under 'available'.",
  "name": "{{ project_slug }}",
  {%- if false %}{# NOT rendered, deliberately: `template` is keel-AS-A-TEMPLATE metadata and a generated project is not a template. Inheriting these six declarations is unrepairable — `_migrations` can only `rm` files — and check_N's final loop reports one error per declared twin whose file does not exist, so the project's first `.jinja` of its own would surface six errors about keel's files. With no block at all, `_declared_twins()` returns {} and check_N still catches the project's own undeclared twin, actionably. Kept here rather than deleted so this file stays a readable parity twin of keel's. #}
  "template": {
    "_comment": "Keel is a copier template: files suffixed .jinja are rendered, everything else is copied verbatim. `twins` declares every .jinja and what it is FOR, so a new one cannot appear unnoticed — scripts/check_structure.py check_N enforces it, render-free, so it runs in the 3.6 pre-commit gate. 'parity' = must reproduce keel's own file except where templated; 'divergence' = must NOT (the difference is the point); 'generated' = copier writes it into a new project and keel commits none of its own. A generated project has no .jinja files, so check_N is silent there.",
    "twins": {
      "pyproject.toml": "parity",
      "config/project.json": "parity",
      "README.md": "parity",
    "docs/guides/README.md": "parity",
    "scripts/jobs/README.md": "parity",
      ".gitignore": "divergence",
      "CHANGELOG.md": "divergence",
      ".copier-answers.yml": "generated"
    }
  },
  {%- endif %}
  "layers": {
{%- if frontend_stack != "none" %}
    "frontend": {
      "stack": "{{ frontend_stack }}",
      "language": "typescript",
      "root": "src/frontend",
      "available": ["{{ frontend_stack }}"]
    },
{%- endif %}
    "backend": {
      "language": "python",
      "python": "{{ backend_python }}",
      "path": "src/backend"
    }
  },
  "transports": {
    "enabled": ["rest", "mcp"{% for t in transports if t not in ["rest", "mcp"] %}, "{{ t }}"{% endfor %}],
    "available": {
      "rest": "api/rest_fastapi",
      "mcp": "mcp"{% if "grpc" in transports %},
      "grpc": "api/grpc"{% endif %}{% if "edge_nginx" in transports %},
      "edge_nginx": "api/edge_nginx"{% endif %}
    }
  },
  "runtimes": {
    "default": "inprocess",
    "available": {
      "inprocess": "runtimes",
      "langgraph": "runtimes"
    }
  },
  "models": {
    "_comment": "Model/provider adapters this project makes available (registered in models/registry.py). 'default' is the registry default; the showcase surfaces this list.",
    "default": "claude-code-headless",
    "available": {
      "claude-code-headless": "models",
      "openai-compatible": "models",
      "fake": "models"
    }
  },
  "practices": {
    "_comment": "Domain coding-practice profiles are DEFINED in config/practices.json (ai/cuda/langgraph) and ENABLED here — flip a flag to true to turn its domain checks on (e.g. cuda -> check_L naked-tensor, resource-context-manager advisory). All off keeps the template domain-neutral. Validated by check_structure.py (check_H); consumed by check_L and check_practices.py.",
    "profiles": {
      "ai": {{ "true" if "ai" in profiles else "false" }},
      "cuda": {{ "true" if "cuda" in profiles else "false" }},
      "langgraph": {{ "true" if "langgraph" in profiles else "false" }}
    }
  }
}
