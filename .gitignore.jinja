# The MCP action server's rebuild_index writes this by default (mcp/action_server.py);
# it is a generated VIEW like the three above, and left untracked-and-unignored it
# dirties the tree — which `make new` refuses to generate from.
wiki/INDEX.md
# generated static showcase snapshot (export_showcase_static.py → frontend reads on backendless/Pages builds)
src/frontend/*/public/api/
src/frontend/*/public/llms.txt
src/frontend/*/public/llms-full.txt
# durable agent-runtime checkpoints (resume-after-crash snapshots; never a source of truth)
wiki/.runtime/
# NOTE: `.copier-answers.yml` is deliberately NOT ignored — it records the template
# answers and `copier update` needs it. A clone or CI checkout without it cannot
# update at all. (Keel's own .gitignore ignores its copy: keel is the template.)
.coverage
coverage.xml
# the gate's evidence record and its junit reports (config/project.json evidence.dir):
# derived on every `make verify`, one commit's verdict, never committed
.evidence
# the launcher's recorded durations (config/project.json launcher.durations_file):
# one person's run history on one host, rewritten on every launch, never committed
.launch
# local config / secrets; config/own-hosts.local.json (launcher.own_hosts_file)
# lists the hosts that are one person's own, and host names are never committed
config/*.local.*
models/config/*.local.*
.env
.env.local
.claude/settings.local.json
# model artifacts (track via LFS or external store, not git)
models/**/*.bin
models/**/*.safetensors
